@page "/auth/login"
@using Microsoft.Extensions.Options
@using SidecarWeb.Options
@layout NotAuthorizedLayout
@inject NavigationManager Nav
@inject IOptions<OAuth2Option> Option

<button type="button" @onclick="OnClicked_Login">
    @Strings.AUTH_LOGIN
</button>

@code {
    private Task OnClicked_Login()
    {
        var clientId = Uri.EscapeDataString(Option.Value.ClientId);
        var redirectUri = Uri.EscapeDataString($"{Nav.BaseUri}auth/login/redirect");
        Nav.NavigateTo($"{Option.Value.Authorize}?client_id={clientId}&redirect_uri={redirectUri}&response_type=code&scope=all");
        return Task.CompletedTask;
    }
}