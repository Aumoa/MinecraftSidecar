@page "/"
@using SidecarWeb.Services
@using SidecarWeb.RconCommands
@inject AuthProvider Auth
@inject RconConnector Rcon
@inject IJSRuntime JSRuntime

<h5>@Strings.DASHBOARD_WELCOME</h5>
<table>
    <tr>
        <th>Sub</th>
        <td>@Auth.Sub</td>
    </tr>
    <tr>
        <th>Players</th>
        <td>@UserList</td>
    </tr>
    <tr>
        <th>Utility</th>
        <td>
            <button type="button" @onclick="SaveAsync">Save</button>
            <button type="button" @onclick="RestartAsync">Restart</button>
        </td>
    </tr>
</table>

@code {
    private string UserList { get; set; } = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var playersResponse = await Rcon.SendCommandAsync(Players.Get());
            UserList = playersResponse.ToString();
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        var response = await Rcon.SendCommandAsync(Save.Get());
        await JSRuntime.InvokeVoidAsync("alert", "World saved successfully!");
    }

    private async Task RestartAsync()
    {
        var response = await Rcon.SendCommandAsync(Stop.Get());
        await JSRuntime.InvokeVoidAsync("alert", "Server is stopping!");
    }
}