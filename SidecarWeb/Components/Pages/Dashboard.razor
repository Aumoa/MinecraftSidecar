@page "/"
@using SidecarWeb.Services
@using SidecarWeb.RconCommands
@inject AuthProvider Auth
@inject RconConnector Rcon
@inject IJSRuntime JSRuntime

<div class="title-layout">
    <h3>@Strings.DASHBOARD_WELCOME</h3>
    <button class="image-button">
        <span class="material-symbols-outlined">refresh</span>
    </button>
</div>

<table>
    <tr>
        <th>@Strings.DASHBOARD_ACTIVATED_USERS</th>
        <td>@UserCount</td>
    </tr>
</table>

@code {
    private int UserCount { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var playersResponse = await Rcon.SendCommandAsync(Players.Get());
            UserCount = playersResponse.Users.Length;
            StateHasChanged();
        }
    }
}