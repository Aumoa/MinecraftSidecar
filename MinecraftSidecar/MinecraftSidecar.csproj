<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoreRCON" Version="5.4.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorSharedComponent\BlazorSharedComponent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="OAuth2.Abstractions">
      <HintPath>..\OAuth2.Abstractions\OAuth2.Abstractions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
