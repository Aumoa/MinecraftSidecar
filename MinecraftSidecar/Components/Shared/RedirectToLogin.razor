@using Microsoft.Extensions.Options
@using MinecraftSidecar.Options
@inject NavigationManager Nav
@inject IOptions<OIDC> Options
@layout NotAuthorizedLayout

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var clientId = Uri.EscapeDataString(Options.Value.ClientId);
            var redirectUri = Uri.EscapeDataString($"{Nav.BaseUri}redirect");
            Nav.NavigateTo($"{Options.Value.Uri}/authorize?client_id={clientId}&redirect_uri={redirectUri}&response_type=code&scope=all");
            return Task.CompletedTask;
        }

        return base.OnAfterRenderAsync(firstRender);
    }
}