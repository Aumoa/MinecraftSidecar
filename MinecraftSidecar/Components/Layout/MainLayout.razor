@inherits LayoutComponentBase

<AuthorizeView>
    <Authorized>
        <div class="page">
            <div class="sidebar">
                <NavMenu Title="@Strings.APP_TITLE" Items="Items" />
            </div>

            <main>
                <div class="top-row px-4">
                    <div class="ms-auto d-flex align-items-center">
                        <ProfileCard />
                    </div>
                </div>

                <article class="content px-4">
                    @Body
                </article>
            </main>
        </div>

        <div id="blazor-error-ui">
            An unhandled error has occurred.
            <a href="" class="reload">Reload</a>
            <a class="dismiss">🗙</a>
        </div>

        @code {
            private static readonly NavMenu.NavMenuItem[] Items =
            [
                new(Strings.NAVMENU_LABEL_DASHBOARD, "dashboard", "/"),
                new(Strings.NAVMENU_LABEL_SERVER_CONSOLE, "terminal", "/console"),
                new(Strings.NAVMENU_LABEL_PLAYERS, "group", "/players")
            ];
        }
    </Authorized>
    <NotAuthorized>
        <RedirectToLogin />
    </NotAuthorized>
</AuthorizeView>